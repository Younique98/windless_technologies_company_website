# Resend (https://resend.com) - used to deliver contact form submissions.
# Without these two set, the contact form still validates and logs
# submissions server-side, but does not send email.
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Public site URL used for canonical links, sitemap, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://windlesstechnologies.com
