# Resend (https://resend.com) - used to deliver contact form submissions.
# Without these two set, the contact form still validates and logs
# submissions server-side, but does not send email.
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Public site URL used for canonical links, sitemap, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://windlesstechnologies.com

# Erica's own free Calendly booking link (e.g. https://calendly.com/her-username/consultation),
# created separately in her Calendly account. Calendly's free tier has no API,
# so this is only ever used to embed/link to the public scheduling page - never
# called from our own backend. Leave unset until that link exists: the "Book a
# call" option on /contact hides itself automatically when this is empty, it
# does not render a broken widget.
NEXT_PUBLIC_CALENDLY_URL=
